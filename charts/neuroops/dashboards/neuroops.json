{
  "title": "NeuroOps — Service Overview",
  "uid": "neuroops-overview",
  "tags": ["neuroops", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (selected range)",
      "description": "Share of / and /load requests that did not return 5xx over the dashboard time range. SLO target: __SLO_TARGET__.",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": __SLO_TARGET__ }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((sum(increase(neuroops_http_requests_total{namespace=\"__NAMESPACE__\",route=~\"/|/load\",code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(neuroops_http_requests_total{namespace=\"__NAMESPACE__\",route=~\"/|/load\"}[$__range])))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget remaining (selected range)",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (((sum(increase(neuroops_http_requests_total{namespace=\"__NAMESPACE__\",route=~\"/|/load\",code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(neuroops_http_requests_total{namespace=\"__NAMESPACE__\",route=~\"/|/load\"}[$__range]))) / (1 - __SLO_TARGET__))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(neuroops_http_requests_total{namespace=\"__NAMESPACE__\",route=~\"/|/load\"}[1m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 latency (/)",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": __LATENCY_P99__ }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(neuroops_http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\",route=\"/\"}[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Available pods",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"__NAMESPACE__\",deployment=\"__APP__\"})"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Pod restarts (selected range)",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"__NAMESPACE__\",container=\"__APP__\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests / s by route and status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, code) (rate(neuroops_http_requests_total{namespace=\"__NAMESPACE__\"}[1m]))",
          "legendFormat": "{{route}} {{code}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "5xx ratio vs SLO error budget",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(neuroops_http_requests_total{namespace=\"__NAMESPACE__\",route=~\"/|/load\",code=~\"5..\"}[5m])) or vector(0)) / sum(rate(neuroops_http_requests_total{namespace=\"__NAMESPACE__\",route=~\"/|/load\"}[5m]))",
          "legendFormat": "5xx ratio (5m)"
        },
        {
          "refId": "B",
          "expr": "vector(1 - __SLO_TARGET__)",
          "legendFormat": "error budget (1 - SLO)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency on / (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(neuroops_http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\",route=\"/\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(neuroops_http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\",route=\"/\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(neuroops_http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\",route=\"/\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Replicas (HPA)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"__NAMESPACE__\",horizontalpodautoscaler=\"__HPA__\"})",
          "legendFormat": "current"
        },
        {
          "refId": "B",
          "expr": "sum(kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"__NAMESPACE__\",horizontalpodautoscaler=\"__HPA__\"})",
          "legendFormat": "desired"
        },
        {
          "refId": "C",
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"__NAMESPACE__\",deployment=\"__APP__\"})",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU usage per pod (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"__NAMESPACE__\",container=\"__APP__\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Logs (Loki)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"__NAMESPACE__\", container=\"__APP__\"}"
        }
      ]
    }
  ]
}
